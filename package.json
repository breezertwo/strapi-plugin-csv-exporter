{
  "name": "strapi-plugin-csv-exporter",
  "version": "5.5.2",
  "description": "A highly configurable plugin to export your Strapi content as CSV files",
  "keywords": [
    "csv",
    "csv exporter",
    "exporter",
    "plugin",
    "strapi",
    "strapi-plugin-csv-exporter",
    "table export",
    "table exporter"
  ],
  "homepage": "https://github.com/breezertwo/strapi-plugin-csv-exporter#readme",
  "bugs": {
    "url": "https://github.com/breezertwo/strapi-plugin-csv-exporter/issues"
  },
  "license": "MIT",
  "author": "breezertwo <andreas@heycare.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/breezertwo/strapi-plugin-csv-exporter.git"
  },
  "files": [
    "dist"
  ],
  "type": "commonjs",
  "exports": {
    "./package.json": "./package.json",
    "./strapi-admin": {
      "types": "./dist/admin/src/index.d.ts",
      "source": "./admin/src/index.ts",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./strapi-server": {
      "types": "./dist/server/src/index.d.ts",
      "source": "./server/src/index.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "strapi-plugin build",
    "watch": "strapi-plugin watch",
    "watch:link": "strapi-plugin watch:link",
    "verify": "strapi-plugin verify",
    "test:ts:front": "tsc -p admin/tsconfig.json --noEmit",
    "test:ts:back": "tsc -p server/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@date-fns/tz": "1.5.0",
    "date-fns": "4.4.0"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "12.0.0",
    "@strapi/design-system": "2.2.3",
    "@strapi/icons": "2.2.3",
    "@strapi/sdk-plugin": "6.1.1",
    "@strapi/strapi": "^5.51.0",
    "@strapi/typescript-utils": "^5.51.0",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "prettier": "^3.9.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-intl": "6.6.2",
    "react-router-dom": "^6.30.3",
    "release-it": "^21.0.1",
    "styled-components": "^6.3.8",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@strapi/design-system": "^2.2.3",
    "@strapi/icons": "^2.2.3",
    "@strapi/strapi": "^5",
    "react": "^18",
    "react-dom": "^18",
    "react-intl": "^6.6.2",
    "react-router-dom": "^6",
    "styled-components": "^6"
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "angular"
      }
    }
  },
  "strapi": {
    "kind": "plugin",
    "name": "csv-exporter",
    "displayName": "CSV Exporter",
    "description": "A highly configurable plugin to export your Strapi content as CSV files"
  }
}
